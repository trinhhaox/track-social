# ===== Chiến dịch =====
CAMPAIGN_NAME="Sống xanh cùng TRIG"
# Viết KHÔNG có dấu # (trong .env, # là bắt đầu comment). Nhiều hashtag cách nhau bằng dấu phẩy.
CAMPAIGN_HASHTAGS=trigxanh
CAMPAIGN_START=2026-10-15
CAMPAIGN_END=2026-11-15

# ===== Đăng nhập trang quản trị /admin =====
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# ===== Apify (quét hashtag trang cá nhân) — https://console.apify.com/settings/integrations =====
APIFY_TOKEN=
# Số bài tối đa mỗi lần quét cho mỗi hashtag (0,005 USD/bài)
HASHTAG_RESULTS_LIMIT=300
# Số bình luận tối đa tải cho mỗi bài (0,0025 USD/bình luận)
COMMENTS_PER_POST=300

# ===== Fanpage của bạn (Graph API, tuỳ chọn) =====
# Page access token có quyền pages_read_engagement, pages_read_user_content
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ===== AI chấm bài (tuỳ chọn) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_RUBRIC="Đúng chủ đề chiến dịch; nội dung chân thực, có trải nghiệm cá nhân; sáng tạo; trình bày rõ ràng; có hình ảnh/video tự làm."

# ===== Xếp hạng =====
# Điểm = reaction×cảm xúc + comment×bình luận + share×chia sẻ + ai×điểm AI (0–10)
RANK_WEIGHTS=reaction=1,comment=2,share=3,ai=0
LEADERBOARD_SIZE=50

# ===== Lịch chạy =====
SCHEDULER_ENABLED=true
SCAN_INTERVAL_HOURS=24
REFRESH_INTERVAL_HOURS=24
# Tiếp tục cập nhật số liệu bao nhiêu ngày sau khi chiến dịch kết thúc
REFRESH_GRACE_DAYS=7

PORT=3000
DATABASE_PATH=./data/campaign.db
